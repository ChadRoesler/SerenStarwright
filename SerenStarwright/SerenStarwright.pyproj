<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>7a4f1c2e-9d63-4b18-8f5a-2c6e1b3d90aa</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <!-- F5 starts the TUI. See the debugging note at the bottom of this file
         for why the textual devtools runner is usually a better way. -->
    <StartupFile>seren_starwright\seren-starwright.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>SerenStarwright</Name>
    <RootNamespace>SerenStarwright</RootNamespace>
    <!-- DELIBERATELY BLANK, unlike the other Seren repos which set Pytest.
         test-starwright.py is a standalone async runner with its own check()
         helpers, not a pytest suite. Pointing Test Explorer at it would just
         report "0 tests found" and look broken. Run it with
         `bash starwright.sh` plus the selftest flag, or F5 with
         test-starwright.py as the startup file. -->
    <TestFramework>
    </TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="seren_starwright\" />
    <Folder Include="services\" />
    <Folder Include="services\bash\" />
    <Folder Include="services\lib\" />
    <Folder Include="services\powershell\" />
    <Folder Include="nodes\" />
    <Folder Include="nodes\lib\" />
    <Folder Include="nodes\nano\" />
    <Folder Include="nodes\spark\" />
    <Folder Include="nodes\xavier\" />
    <Folder Include=".github\" />
    <Folder Include=".github\workflows\" />
  </ItemGroup>
  <!-- ONLY the Python is enumerated, on purpose.
       The 48 shell scripts and 22 PowerShell scripts are NOT listed as
       Content items. Enumerating them would mean every script that moves or
       gets added needs a matching edit in here: a second source of truth about
       which files exist, which is the bug class this repo spent two days
       eliminating everywhere else (a drifted manifest, a drifted service
       table, a drifted flag list, two JSON escapers, a silently dropped
       service).
       Solution Explorer's "Show All Files" toggle browses them fine, and
       NOTHING builds from this file (CI never reads it), so an unlisted script
       costs a tree entry, not a broken build. -->
  <ItemGroup>
    <Compile Include="seren_starwright\seren-starwright.py" />
    <Compile Include="test-starwright.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="nodes\lib\build-prebuilts.sh" />
    <Content Include="nodes\lib\common.sh" />
    <Content Include="nodes\lib\seren-sudoers-update.sh" />
    <Content Include="nodes\lib\seren-wipe.sh" />
    <Content Include="nodes\nano\build.sh" />
    <Content Include="nodes\nano\chroma.sh" />
    <Content Include="nodes\nano\comfy.sh" />
    <Content Include="nodes\nano\coral.sh" />
    <Content Include="nodes\nano\foundation.sh" />
    <Content Include="nodes\nano\kokoro.sh" />
    <Content Include="nodes\nano\llama.sh" />
    <Content Include="nodes\nano\prebuilts.sh" />
    <Content Include="nodes\spark\chroma.sh" />
    <Content Include="nodes\spark\comfy.sh" />
    <Content Include="nodes\spark\foundation.sh" />
    <Content Include="nodes\spark\kokoro.sh" />
    <Content Include="nodes\spark\llama.sh" />
    <Content Include="nodes\xavier\build.sh" />
    <Content Include="nodes\xavier\chroma.sh" />
    <Content Include="nodes\xavier\comfy.sh" />
    <Content Include="nodes\xavier\coral.sh" />
    <Content Include="nodes\xavier\foundation.sh" />
    <Content Include="nodes\xavier\kokoro.sh" />
    <Content Include="nodes\xavier\llama.sh" />
    <Content Include="nodes\xavier\prebuilts.sh" />
    <Content Include="services\bash\seren-corpus-callosum-setup.sh" />
    <Content Include="services\bash\seren-loci-setup.sh" />
    <Content Include="services\bash\seren-lodestar-setup.sh" />
    <Content Include="services\bash\seren-margin-setup.sh" />
    <Content Include="services\bash\seren-memory-setup.sh" />
    <Content Include="services\bash\seren-observatory-setup.sh" />
    <Content Include="services\bash\seren-probe-setup.sh" />
    <Content Include="services\bash\seren-workbench-setup.sh" />
    <Content Include="services\bash\setup-corpus-callosum-service.sh" />
    <Content Include="services\bash\setup-loci-service.sh" />
    <Content Include="services\bash\setup-lodestar-service.sh" />
    <Content Include="services\bash\setup-margin-service.sh" />
    <Content Include="services\bash\setup-memory-service.sh" />
    <Content Include="services\bash\setup-observatory-service.sh" />
    <Content Include="services\bash\setup-probe-service.sh" />
    <Content Include="services\bash\setup-workbench-service.sh" />
    <Content Include="services\lib\seren-install-lib.ps1" />
    <Content Include="services\lib\seren-install-lib.sh" />
    <Content Include="services\lib\seren-register-services.sh" />
    <Content Include="services\lib\setup-seren-dotnet-service.ps1" />
    <Content Include="services\lib\setup-seren-dotnet-service.sh" />
    <Content Include="services\lib\setup-seren-python-service.sh" />
    <Content Include="services\lib\setup-seren-service.ps1" />
    <Content Include="services\lib\setup-seren-service.sh" />
    <Content Include="services\powershell\seren-corpus-callosum-setup.ps1" />
    <Content Include="services\powershell\seren-loci-setup.ps1" />
    <Content Include="services\powershell\seren-lodestar-setup.ps1" />
    <Content Include="services\powershell\seren-margin-setup.ps1" />
    <Content Include="services\powershell\seren-memory-setup.ps1" />
    <Content Include="services\powershell\seren-observatory-setup.ps1" />
    <Content Include="services\powershell\seren-probe-setup.ps1" />
    <Content Include="services\powershell\seren-workbench-setup.ps1" />
    <Content Include="services\powershell\setup-corpus-callosum-service.ps1" />
    <Content Include="services\powershell\setup-loci-service.ps1" />
    <Content Include="services\powershell\setup-lodestar-service.ps1" />
    <Content Include="services\powershell\setup-margin-service.ps1" />
    <Content Include="services\powershell\setup-memory-service.ps1" />
    <Content Include="services\powershell\setup-observatory-service.ps1" />
    <Content Include="services\powershell\setup-probe-service.ps1" />
    <Content Include="services\powershell\setup-workbench-service.ps1" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Build is intentionally NOT wired up. The deliverable is
       dist/starwright.pyz, produced by build-starwright.sh (or the .ps1),
       which also runs the pure-Python guard and a standalone smoke test.
       Enabling CoreCompile here would create a second, weaker build path that
       skips both.

       DEBUGGING A TEXTUAL APP: plain F5 is awkward, because the TUI owns the
       terminal and VS's console window mangles it. The real workflow is two
       terminals, using textual's devtools:
           terminal 1:   textual console
           terminal 2:   textual run [dev flag] seren_starwright/seren-starwright.py
       print() and log output then land in the console window instead of
       fighting the UI for the screen.

       XML NOTE for whoever edits these comments next: a double hyphen is
       ILLEGAL inside an XML comment, so flag names cannot be written with
       their leading dashes in here. The first draft of this file was full of
       them and Visual Studio would have refused to open it. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>