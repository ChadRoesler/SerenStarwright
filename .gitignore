# Python bytecode - anywhere, not just the one directory it used to live in.
# A path-pinned rule (/Generics/__pycache__) stopped matching the moment the
# tree was reorganised, and a stale .pyc got committed.
__pycache__/
*.py[cod]

# Build output from build-starwright.{sh,ps1}
/dist/

# The zipapp's extraction cache, if anyone points it here
.seren-starwright/

# Runtime artifacts from actually running node prep. seren-prepare-node.sh
# writes both of these next to itself: the log it tees detail into, and the jq
# state file that makes foundation phases resumable. Anyone who runs prep from
# a checkout produces them, so they must never be committed - and a committed
# state file would be worse than noise, since it would tell a fresh clone that
# phases it has never run are already complete.
seren-setup.log
.seren-setup.state.json

# Visual Studio local cache. Created the first time SerenStarwright.slnx is
# opened, holds absolute paths and a browse database, and must never be
# committed. Every other Seren repo already ignores this; when I rewrote this
# file to de-pin the __pycache__ rule I dropped the VS entries with it.
.vs/
*.user
*.suo
[Bb]in/
[Oo]bj/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
